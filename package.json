{
  "name": "@fallom/openui",
  "version": "1.2.1",
  "description": "Visual canvas UI for managing AI coding agents locally",
  "author": "JJ27",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJ27/openui.git"
  },
  "bugs": {
    "url": "https://github.com/JJ27/openui/issues"
  },
  "homepage": "https://github.com/JJ27/openui#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "opencode",
    "terminal",
    "canvas",
    "ui"
  ],
  "type": "module",
  "bin": {
    "openui": "./bin/openui.ts"
  },
  "files": [
    "bin/",
    "server/",
    "client/dist/",
    "README.md"
  ],
  "scripts": {
    "start": "bun run server/index.ts",
    "dev": "concurrently \"bun run --watch server/index.ts\" \"bun run --cwd client dev\"",
    "build": "bun run --cwd client build",
    "test": "bun test server/ client/src scripts/ shared/",
    "typecheck": "tsc --noEmit && bun run --cwd client tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build && bun run audit",
    "acceptance": "bun run scripts/acceptance/v052.mjs",
    "new": "bun run scripts/start-project.mjs",
    "demo": "bun run scripts/demo/setup.mjs",
    "audit": "bun run scripts/audit/reachability.mjs && bun run audit:endpoints && bun run audit:quality && bun run audit:docs",
    "audit:endpoints": "bun run scripts/audit/endpoints.mjs",
    "audit:quality": "bun run scripts/audit/quality.mjs",
    "audit:docs": "bun run scripts/audit/docs.mjs",
    "prepublishOnly": "bun run build",
    "install:client": "cd client && bun install",
    "demo:workspace": "bun run scripts/demo/workspace.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xai-official/grok": "^0.2.118",
    "bun-pty": "^0.4.8",
    "hono": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
